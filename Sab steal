local TracerFolder

local function GetTracerFolder()

	if not TracerFolder
		or not TracerFolder.Parent then

		TracerFolder =
			Instance.new("Folder")

		TracerFolder.Name =
			"SakuraTracers"

		TracerFolder.Parent =
			workspace
	end

	return TracerFolder
end

local function RemovePlayerTracer(player)

	if not TracerFolder then
		return
	end

	local beam =
		TracerFolder:FindFirstChild(
			"Tracer_" ..
			player.UserId
		)

	if beam then
		beam:Destroy()
	end
end

local function CreateTracer(player)

	if not TracersEnabled then
		return
	end

	if player == LP then
		return
	end

	if not Root or not Root.Parent then
		return
	end

	local character =
		player.Character

	if not character then
		return
	end

	local targetRoot =
		character:FindFirstChild(
			"HumanoidRootPart"
		)

	local targetHum =
		character:FindFirstChildOfClass(
			"Humanoid"
		)

	if not targetRoot
		or not targetHum
		or targetHum.Health <= 0 then

		RemovePlayerTracer(player)

		return
	end

	local folder =
		GetTracerFolder()

	local beamName =
		"Tracer_" ..
		player.UserId

	local existing =
		folder:FindFirstChild(
			beamName
		)

	-- Проверяем, что существующая линия
	-- действительно соединяет нужного игрока.
	if existing then

		if existing:IsA("Beam")
			and existing.Attachment1
			and existing.Attachment1.Parent
				== targetRoot then

			return
		end

		existing:Destroy()
	end

	--==================================================
	-- LOCAL ATTACHMENT
	--==================================================

	local localAttachment =
		Root:FindFirstChild(
			"SakuraLocalTracer"
		)

	if not localAttachment then

		localAttachment =
			Instance.new("Attachment")

		localAttachment.Name =
			"SakuraLocalTracer"

		localAttachment.Position =
			Vector3.new(0,0,0)

		localAttachment.Parent =
			Root
	end

	--==================================================
	-- TARGET ATTACHMENT
	--==================================================

	local targetAttachment =
		targetRoot:FindFirstChild(
			"SakuraTargetTracer_" ..
			LP.UserId
		)

	if not targetAttachment then

		targetAttachment =
			Instance.new("Attachment")

		targetAttachment.Name =
			"SakuraTargetTracer_" ..
			LP.UserId

		targetAttachment.Position =
			Vector3.new(0,0,0)

		targetAttachment.Parent =
			targetRoot
	end

	--==================================================
	-- BEAM
	--==================================================

	local beam =
		Instance.new("Beam")

	beam.Name =
		beamName

	beam.Attachment0 =
		localAttachment

	beam.Attachment1 =
		targetAttachment

	beam.FaceCamera =
		true

	beam.Enabled =
		true

	beam.Width0 =
		0.12

	beam.Width1 =
		0.12

	beam.LightEmission =
		1

	beam.LightInfluence =
		0

	beam.Segments =
		1

	beam.Transparency =
		NumberSequence.new(0)

	beam.Color =
		ColorSequence.new(
			Color3.fromRGB(
				255,
				45,
				45
			)
		)

	beam.Parent =
		folder
end

local function ClearTracers()

	if TracerFolder then
		TracerFolder:Destroy()
		TracerFolder = nil
	end

	-- Удаляем локальные attachment'ы.
	if Root then

		local localAttachment =
			Root:FindFirstChild(
				"SakuraLocalTracer"
			)

		if localAttachment then
			localAttachment:Destroy()
		end
	end

	-- Удаляем target attachment'ы.
	for _,player in ipairs(
		Players:GetPlayers()
	) do

		local character =
			player.Character

		if character then

			local targetRoot =
				character:FindFirstChild(
					"HumanoidRootPart"
				)

			if targetRoot then

				local attachment =
					targetRoot:FindFirstChild(
						"SakuraTargetTracer_" ..
						LP.UserId
					)

				if attachment then
					attachment:Destroy()
				end
			end
		end
	end
end

local function UpdateTracers()

	if not TracersEnabled then
		ClearTracers()
		return
	end

	if not Root or not Root.Parent then
		return
	end

	for _,player in ipairs(
		Players:GetPlayers()
	) do

		if player ~= LP then
			CreateTracer(player)
		end
	end
end

