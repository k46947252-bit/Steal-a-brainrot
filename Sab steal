local function ApplyAntiDie()

	if not Humanoid then
		return
	end

	if AntiDieEnabled then

		Humanoid.BreakJointsOnDeath =
			false

		pcall(function()

			Humanoid:SetStateEnabled(
				Enum.HumanoidStateType.Dead,
				false
			)

		end)

	else

		Humanoid.BreakJointsOnDeath =
			true

		pcall(function()

			Humanoid:SetStateEnabled(
				Enum.HumanoidStateType.Dead,
				true
			)

		end)
	end
end

