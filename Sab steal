		UDim2.new(
			0,
			5,
			0,
			3
		)

	label.BackgroundTransparency =
		1

	label.Text =
		"FPS: --\nMS: --\nPING: --"

	label.TextColor3 =
		Color3.fromRGB(
			235,
			235,
			235
		)

	label.Font =
		Enum.Font.GothamBold

	label.TextSize =
		12

	label.TextXAlignment =
		Enum.TextXAlignment.Left

	label.TextYAlignment =
		Enum.TextYAlignment.Center

	label.Parent =
		panel

	local frames = 0
	local lastTime = os.clock()

	local frameTimes = {}

	RunService.RenderStepped:Connect(
		function(dt)

			if not panel.Parent then
				return
			end

			frames += 1

			table.insert(
				frameTimes,
				dt
			)

			if #frameTimes > 30 then
				table.remove(
					frameTimes,
					1
				)
			end

			local now =
				os.clock()

			if now - lastTime >= 0.5 then

				local fps =
					math.floor(
						frames /
						(now-lastTime)
						+ 0.5
					)

				frames = 0
				lastTime = now

				local average = 0

				for _,value in ipairs(
					frameTimes
				) do

					average += value
				end

				if #frameTimes > 0 then
					average /=
						#frameTimes
				end

				local ms =
					math.floor(
						average * 1000
						+ 0.5
					)

				local ping = "--"

				pcall(function()

					local network =
						Stats.Network

					local serverStats =
						network.ServerStatsItem

					local dataPing =
						serverStats:FindFirstChild(
							"Data Ping"
						)

					if dataPing then

						local value =
							dataPing:GetValue()

						if value then

							ping =
								math.floor(
									value + 0.5
								)
						end
					end
				end)

				label.Text =
					"FPS: " ..
					fps ..
					"\nMS: " ..
					ms ..
					"\nPING: " ..
					ping ..
					(
						ping ~= "--"
						and " ms"
						or ""
					)
			end
		end
	)
end

