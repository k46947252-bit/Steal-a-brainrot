	loading.TextSize =
		24

	loading.Parent =
		background

	local startTime =
		os.clock()

	while os.clock() - startTime < 3 do

		local remaining =
			math.max(
				0,
				3 -
				(os.clock() - startTime)
			)

		loading.Text =
