task.spawn(function()

	while true do

		if TracersEnabled
			and TracerFolder
			and TracerFolder.Parent then

			local timeValue =
				os.clock() * 1.8

			local alpha =
				(math.sin(timeValue) + 1) / 2

			local red =
				Color3.fromRGB(
					255,
					45,
					45
				)

			local white =
				Color3.fromRGB(
					255,
					255,
					255
				)

			local gray =
				Color3.fromRGB(
					145,
					145,
					145
				)

			local color

			if alpha < 0.5 then

				color =
					red:Lerp(
						white,
						alpha * 2
					)

			else

				color =
					white:Lerp(
						gray,
						(alpha - 0.5) * 2
					)
			end

			for _,object in ipairs(
				TracerFolder:GetChildren()
			) do

				if object:IsA("Beam") then

					object.Enabled = true

					object.Color =
						ColorSequence.new(
							color
						)
				end
			end
		end

		task.wait(0.025)
	end
end)

