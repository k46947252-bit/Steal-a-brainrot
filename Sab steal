--==================================================
-- CHARACTER EVENTS
--==================================================

LP.CharacterAdded:Connect(
	function(newCharacter)

		Character =
			newCharacter

		Humanoid =
			Character:WaitForChild(
				"Humanoid"
			)

		Root =
			Character:WaitForChild(
				"HumanoidRootPart"
			)

		task.wait(0.3)

		if Loaded then
			ShowResetComplete()
		end

		task.wait(0.2)

		if AntiDieEnabled then
			ApplyAntiDie()
		end

		AddDiscordTag(
			Character
		)

		if TracersEnabled then
			ClearTracers()
			task.wait(0.1)
			UpdateTracers()
		end

		if ESPEnabled then
			UpdateESP()
		end
	end
)

Players.PlayerAdded:Connect(
	function(player)

		player.CharacterAdded:Connect(
			function()

				task.wait(0.3)

				if ESPEnabled then
					CreateESP(player)
				end

				if TracersEnabled then
					CreateTracer(player)
				end
			end
		)
	end
)

Players.PlayerRemoving:Connect(
	function(player)

		RemovePlayerTracer(player)
	end
)

--==================================================
-- UPDATE
--==================================================

local lastUpdate = 0

RunService.RenderStepped:Connect(
	function()

		if not Loaded then
			return
		end

		if not Character
			or not Character.Parent then
			return
		end

		if BatEnabled then
			UpdateBat()
		end

		if AntiDieEnabled then
			ApplyAntiDie()
		end

		if os.clock() - lastUpdate >= 0.08 then

			lastUpdate =
				os.clock()

			if ESPEnabled then
				UpdateESP()
			end

			if TracersEnabled then
				UpdateTracers()
			end
		end
	end
)

